# 渠道服务环境变量模板 —— 复制为 .env 后填入真实值（.env 已被 .gitignore 排除）

# 坤柔上游地址与主 Key（视频 / 文本 / 音频）
CHANNEL_UPSTREAM_BASE=https://api.kunrouai.com
CHANNEL_UPSTREAM_KEY=sk-xxxx

# 对外暴露的公网基础地址（用于拼接返回链接，可留空）
CHANNEL_PUBLIC_BASE=

# 渠道令牌签名密钥（随机长字符串，泄露等于交出渠道）
CHANNEL_TOKEN_SECRET=change-me-to-a-long-random-string

# 初始账户余额（演示账户）
CHANNEL_INITIAL_BALANCE=20

# 图片代理分组
CHANNEL_IMAGE_UPSTREAM_KEY=sk-xxxx
CHANNEL_IMAGE_MODELS=gpt-image-2,gpt-image-2.5,gpt-image-2.6

# Gemini 图片分组（Nano Banana 系列）
CHANNEL_GEMINI_UPSTREAM_KEY=sk-xxxx
CHANNEL_GEMINI_MODELS=gemini-nano-banana-2.1,gemini-3-pro-image,gemini-3-pro-image-preview,gemini-3.1-flash-image,gemini-3.1-flash-image-preview

# 短信验证码 Webhook（登录用，可留空）
CHANNEL_SMS_WEBHOOK=
